# SnapBot Environment Configuration
# Copy this file to .env and fill in your values.

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Resend Email Delivery
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="SnapBot <admin@koharu.live>"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://snapbot.koharu.live"
NEXTAUTH_URL="https://snapbot.koharu.live"

# Security & Authentication Secrets
AUTH_SECRET="your-32-character-random-secret-for-session-tokens"
JWT_SECRET="your-32-character-random-secret-for-session-tokens"

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

